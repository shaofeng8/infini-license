# ---------------------------------------------------------------------------
# 应用
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_PORT=3010
APP_GLOBAL_PREFIX=api
APP_NAME=infini-license

# 前面隔着几层反向代理。本地直连填 0；生产（宿主 nginx 反代）填 1。
# 决定 req.ip 怎么算 —— 审计日志的 IP 列与限流分桶都取自它。
# 详见 src/config/app.config.ts 里 trustProxyHops 的注释
TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=license_root_dev
# 用下划线而非连字符：MySQL 里带连字符的库名每次引用都得加反引号，
# 且不少运维工具会解析失败
MYSQL_DATABASE=infini_license

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# 主密钥：加密 lc_signing_key.private_key_cipher 与 lc_instance.secret_cipher
# 32 字节，base64 编码。生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 一旦签发过凭证，这个值就绝对不能变——换掉它等于丢失所有私钥，
# 已签发的凭证仍然有效（客户端只验公钥），但无法再为老 kid 续签。
# ---------------------------------------------------------------------------
LICENSE_MASTER_KEY=

# ---------------------------------------------------------------------------
# 管理后台认证
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=8h

# 首次启动自动创建的 owner 账号；创建后请立刻改密，并把这两行清空
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 试用模式默认参数：客户端注册试用时套用
# ---------------------------------------------------------------------------
TRIAL_DAYS=30
TRIAL_MAX_USERS=10
TRIAL_TOKEN_QUOTA=50000000
TRIAL_TASK_QUOTA=2000
TRIAL_MAX_CONCURRENT_TASKS=2
TRIAL_WARN_DAYS=7

# ---------------------------------------------------------------------------
# 凭证签发约束
# ---------------------------------------------------------------------------
# 单次签发的最长有效期（天）。0 = 不限制，由签发人自行判断。
# 需要硬性拦截时改成具体天数（例如 400 覆盖一年期合同 + 交付缓冲）。
LICENSE_MAX_TERM_DAYS=0

# 超过这个天数的签发会记警告日志并在审计详情里打 longTerm 标记。
# 没有远程吊销通道，一份签出去五年的凭证在这五年里我们完全无从干预，
# 所以即便不拦，也要能事后查到是谁在什么时候签的。
LICENSE_LONG_TERM_WARN_DAYS=760
