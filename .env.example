# ---------------------------------------------------------------------------
# docker compose 部署配置
#
# 复制成 .env 后填写。compose 会自动加载同目录的 .env 做 ${} 插值。
#
# 这份是**部署配置**，跟 packages/server/.env.development 不是一回事 ——
# 后者只在本机 `pnpm dev` 时用，不参与容器。
# ---------------------------------------------------------------------------

# 端口绑定地址。默认只绑 127.0.0.1，外部访问一律走宿主机 nginx 的 443。
# 改成 0.0.0.0 就等于把 MySQL 和后端直接挂到公网上，除非你清楚在做什么
BIND_ADDR=127.0.0.1

MYSQL_PORT=3307
REDIS_PORT=6380
SERVER_PORT=3010
WEB_PORT=5273

# 后端前面隔着几层反向代理。默认 1 = 只有宿主机的 nginx。
#
# 这个数决定 req.ip 怎么算，而它有两个要紧的下游：审计日志的 IP 列
# （谁下载了哪份凭证）、以及限流的分桶键。设小了所有人被记成同一个代理
# 地址、共用一个限流桶；设大了客户端可以自己伪造 X-Forwarded-For 把 IP
# 写成任意值并绕开限流。要的是**准确的层数**，不是越大越安全。
# 前面再加 CDN 或 SLB 就按实际层数往上加
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_USER=root
MYSQL_DATABASE=infini_license

REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# 主密钥：加密 lc_signing_key.private_key_cipher 与 lc_instance.secret_cipher
#
# 生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 【一旦签发过凭证就绝对不能改】换掉它等于丢失库里所有签名私钥。已经发出去
# 的凭证仍然有效（客户端只验公钥），但你再也无法为那个 kid 续签，只能换新
# 密钥重签并要求所有老客户更换 license.key —— 而离线客户根本收不到通知。
#
# 必须单独备份，且不要与数据库备份存放在同一处：两者一起泄露就等于
# 别人可以任意签发凭证。
# ---------------------------------------------------------------------------
LICENSE_MASTER_KEY=

# 管理后台登录用。换掉会让所有在登录态的运营被踢下线（重登即可）
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------------------------
# 首次启动引导账号
#
# 只在库里一个 owner 都没有时才创建。首次登录后立刻改密，
# 并把这两行清空再 `docker compose up -d server` 重启一次
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 试用模式默认参数：客户端注册试用时套用
# ---------------------------------------------------------------------------
TRIAL_DAYS=30
TRIAL_MAX_USERS=10
TRIAL_TOKEN_QUOTA=50000000
TRIAL_TASK_QUOTA=2000
TRIAL_MAX_CONCURRENT_TASKS=2
TRIAL_WARN_DAYS=7

# ---------------------------------------------------------------------------
# 凭证签发约束
# ---------------------------------------------------------------------------
# 单次签发最长有效期（天）。0 = 不限制，由签发人按合同判断
LICENSE_MAX_TERM_DAYS=0
# 超过这个天数只记警告与审计标记，不拦截
LICENSE_LONG_TERM_WARN_DAYS=760

# ---------------------------------------------------------------------------
# 客户支持联系方式
#
# 这三项会被写进签发出去的凭证，是客户被阻断时唯一能看到的求助入口。
# 填错等于客户在最需要联系我们的时候拿到一个打不通的号码
# ---------------------------------------------------------------------------
SUPPORT_NAME=InfiniSynapse 客户成功
SUPPORT_PHONE=
SUPPORT_EMAIL=
