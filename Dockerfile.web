# ============================ 构建阶段 ============================
# ACR 上海构建机访问不了 Docker Hub，基础镜像走 DaoCloud 代理
FROM docker.m.daocloud.io/library/node:22-alpine AS builder

RUN npm config set registry https://registry.npmmirror.com \
    && npm install -g pnpm@8.15.4

WORKDIR /app

# .npmrc 一起拷：里面的 shamefully-hoist 决定了 node_modules 布局，
# 少了它容器里的依赖解析跟本地不是同一套（详见 Dockerfile.server 的说明）
COPY .npmrc pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/server/package.json ./packages/server/
COPY packages/sdk/package.json ./packages/sdk/
COPY packages/web/package.json ./packages/web/

RUN pnpm install --frozen-lockfile --filter @infini-license/web

COPY packages/web ./packages/web

# 刻意**不**注入 VITE_API_BASE_URL。
#
# 注入了就等于把 API 地址焊死在构建产物里，换域名要重新构建；不注入时
# getApiBaseUrl() 走 `${location.origin}/api`，由前面的 CLB 把 /api
# 转到 server。一个镜像到处能跑，web 容器本身不反代 API。
#
# `.dockerignore` 里排掉了 .env*，所以宿主机上那份指向 localhost:3010 的
# .env.development 不会被带进来 —— 真被带进来也不生效（vite 生产构建不读
# development 环境文件），但少一个能让人查半天的干扰项
RUN pnpm run -C packages/web build


# ============================ 运行阶段 ============================
FROM docker.m.daocloud.io/library/nginx:1.27-alpine AS runner

COPY --from=builder /app/packages/web/dist /usr/share/nginx/html
COPY packages/web/nginx.conf /etc/nginx/conf.d/default.conf

ENV TZ=UTC

EXPOSE 80

# 静态站点没有业务健康概念，能返回 index.html 就算活着
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
